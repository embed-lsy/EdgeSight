  <property name="styleSheet">
   <string notr="true">QWidget {
    /* 原有简约青灰渐变背景，保持不变 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3a4050, stop:1 #2f3446);
    color: #e0e8f0;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 14px;
}

/* ========== QTabWidget 样式（保持不变） ========== */
QTabWidget {
    border: none; /* 去掉默认边框，简约 */
}
QTabBar {
    background: #2f3446; /* 和主背景底层统一 */
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #373c4e, stop:1 #2f3446);
    color: #e0e8f0;
    padding: 8px 20px; /* 内边距适中，高级感 */
    margin-right: 2px; /* 标签间微小间距，不拥挤 */
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: none;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4299e120, stop:1 #3182ce15); /* 低饱和蓝渐变，不突兀 */
    color: #a7c0ff; /* 浅蓝文字，突出选中态 */
    border-bottom: 2px solid #4299e1; /* 底部细蓝线，简约高级 */
}
QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #41485c, stop:1 #373c4e);
}
QTabWidget::pane {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3a4050, stop:1 #2f3446); /* 和主背景统一 */
    border: 1px solid #4a5568; /* 细边框，增强层次感 */
    border-radius: 6px;
    margin-top: -2px; /* 贴合选中标签的底部蓝线，无间隙 */
}

/* ========== 核心修改：QScrollArea 滚动条（适配触摸屏） ========== */
QScrollArea {
    border: none; /* 去掉默认边框，简约 */
}
QScrollArea &gt; QWidget &gt; QWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3a4050, stop:1 #2f3446); /* 和主背景统一 */
}
/* 垂直滚动条（触摸屏适配：宽度从12px→24px，更易触碰） */
QScrollBar:vertical {
    width: 24px; /* 关键：增大滚动条宽度，适配触摸屏 */
    background: #2f3446; /* 和背景底层统一 */
    border-radius: 12px; /* 圆角随宽度同步增大，保持比例 */
    margin: 0px 4px 0px 4px; /* 微小边距，不贴边 */
}
/* 垂直滚动条滑块（关键：增大尺寸，最小高度从20px→40px） */
QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4a5568, stop:1 #3a4050); /* 青灰渐变不变 */
    border-radius: 10px; /* 滑块圆角稍小于滚动条，更精致 */
    min-height: 40px; /* 关键：增大滑块最小高度，触摸屏易点击 */
    margin: 4px 2px 4px 2px; /* 滑块和滚动条间留空隙，更易识别 */
}
/* 滚动条滑块悬停 */
QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #546078, stop:1 #4a5568);
}
/* 隐藏滚动条上下箭头（保持简约） */
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    height: 0px;
}
/* 水平滚动条（触摸屏适配：高度从12px→24px） */
QScrollBar:horizontal {
    height: 24px; /* 关键：增大水平滚动条高度 */
    background: #2f3446;
    border-radius: 12px;
    margin: 4px 0px 4px 0px;
}
QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a5568, stop:1 #3a4050);
    border-radius: 10px;
    min-width: 40px; /* 关键：增大水平滑块最小宽度 */
    margin: 2px 4px 2px 4px;
}
QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    width: 0px;
}

/* RadioButton 样式（保持不变） */
QRadioButton {
    color: #e0e8f0; /* 文字色和整体统一 */
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 14px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px; /* 圆形 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #373c4e, stop:1 #2f3446); /* 和背景呼应 */
    border: 1px solid #4a5568; /* 细边框，保持高级感 */
}
QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4299e1, stop:1 #3182ce); /* 高级蓝渐变，不刺眼 */
    border: 1px solid #58a6ff; /* 浅蓝边框，增强层次感 */
}
QRadioButton::indicator:hover {
    border-color: #66b2ff;
}

/* 按钮、输入框样式（保持不变） */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #41485c, stop:1 #373c4e);
    border: 1px solid #4a5568;
    border-radius: 6px;
    padding: 6px 12px;
    color: #e0e8f0;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 14px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a5568, stop:1 #41485c);
    border-color: #546078;
}

QLineEdit, QTextEdit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #363b4b, stop:1 #2f3446);
    border: 1px solid #444c5f;
    border-radius: 4px;
    padding: 4px;
    color: #e0e8f0;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 14px;
}</string>
